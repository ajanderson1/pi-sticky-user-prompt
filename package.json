{
	"name": "pi-sticky-user-prompt",
	"version": "1.0.0",
	"description": "Pins the user message you are reading to the top of the pi transcript - it slides up, stops, and hands over to the previous turn as you scroll back",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"pi-tui",
		"sticky-header",
		"user-message",
		"terminal",
		"tui"
	],
	"homepage": "https://github.com/ajanderson1/pi-sticky-user-prompt#readme",
	"bugs": {
		"url": "https://github.com/ajanderson1/pi-sticky-user-prompt/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ajanderson1/pi-sticky-user-prompt.git"
	},
	"license": "MIT",
	"author": "AJ Anderson",
	"type": "module",
	"scripts": {
		"test": "node --test test/*.test.mjs"
	},
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/sticky-user-prompt"
		],
		"image": "https://raw.githubusercontent.com/ajanderson1/pi-sticky-user-prompt/main/assets/sticky-demo.gif"
	}
}
